# =============================================================================
# Station Manager Pro — modèle de configuration (.env)
# Copier vers .env et renseigner les valeurs avant le premier démarrage.
# Pour un déploiement PC Windows dédié, voir aussi .env.pc.example.
# =============================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL (obligatoire)
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/station_manager

# Secret JWT — minimum 32 caractères aléatoires
# Exemple de génération : openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# CORS (optionnel en dev ; en prod mettre l’URL du front)
# CORS_ORIGIN=https://votre-domaine.com

# Stockage fichiers & sauvegardes (chemins absolus recommandés hors du code)
# UPLOAD_DIR=/var/lib/station-manager/uploads
# BACKUP_DIR=/var/lib/station-manager/backups
BACKUP_KEEP_DAYS=14
BACKUP_AUTO=0

# Opérations sensibles (0 = désactivé par défaut)
RESTORE_ENABLED=0
RESTORE_TARGET_ISOLATED=0
RESET_GLOBAL_ENABLED=0
CLIENT_RESTORE_ENABLED=0
CLIENT_RESET_ENABLED=0
PLATFORM_RESTORE_ENABLED=0

# Alertes automatiques (1 = actif)
# ALERTS_AUTO=1

# E-mail (optionnel — aucun envoi si SMTP non configuré)
# MAIL_MODE=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# BACKUP_NOTIFY_EMAIL=

# Carte stations (SuperAdmin) — jeton PUBLIC Mapbox, restreindre par URL côté Mapbox
# MAPBOX_TOKEN=pk.…

# Outils PostgreSQL si absents du PATH (Windows)
# PG_DUMP=C:/Program Files/PostgreSQL/16/bin/pg_dump.exe
# PSQL=C:/Program Files/PostgreSQL/16/bin/psql.exe

# Pièce jointe e-mail des sauvegardes : laisser à 0 (le dump contient des empreintes de mots de passe et toutes les données clients)
BACKUP_EMAIL_ATTACH=0

# Détail de /api/health (version, uptime, migrations) : défini = en-tête X-Health-Token requis ; 16 caractères minimum
HEALTH_TOKEN=

# Limitation de débit globale (0 = désactivée) et taille des corps JSON hors routes de fichiers
RATE_LIMIT_IP_MAX=600
RATE_LIMIT_USER_MAX=400
JSON_BODY_LIMIT_DEFAULT=2mb

# Longueur minimale des mots de passe ADMIN / SUPERADMIN / comptes de plateforme (défaut 12, jamais moins de 12)
PASSWORD_MIN_PRIVILEGED=12

# Durée des sessions en heures (1 à 24) : comptes ordinaires (défaut 12) et comptes ADMIN/SUPERADMIN/plateforme (défaut 4)
SESSION_HOURS=12
SESSION_HOURS_PRIVILEGED=4

# Sauvegardes jointes aux e-mails : chiffrées (AES-256-GCM) si BACKUP_ENCRYPTION_KEY est définie (16 caractères minimum, à conserver HORS base).
# Sans clé, aucune pièce jointe n’est envoyée, sauf BACKUP_EMAIL_ATTACH_PLAINTEXT=1 (déconseillé : dump en clair).
BACKUP_ENCRYPTION_KEY=
BACKUP_EMAIL_ATTACH_PLAINTEXT=0

# Réconciliation pompé / vendu (CORR-037) : tolérance en % des litres pompés (défaut 0.5)
# RECONCILE_TOLERANCE_PCT=0.5

# ---- Canaux d'alerte (CORR-039) : e-mail = SMTP_* ; SMS et WhatsApp DÉSACTIVÉS par défaut (coût par message) ----
# DEFAULT_COUNTRY_CODE=223
# Pour activer le SMS : SMS_ENABLED=1, puis SMS_PROVIDER=twilio (SMS_API_KEY=jeton, SMS_ACCOUNT_SID, SMS_FROM=+numéro)
#                     ou SMS_PROVIDER=generic (SMS_API_KEY, SMS_API_URL : POST JSON {to,text,from}, jeton Bearer)
# SMS_ENABLED=0
# WhatsApp : mêmes variables préfixées WHATSAPP_ (WHATSAPP_ENABLED=1, WHATSAPP_PROVIDER, WHATSAPP_API_KEY, WHATSAPP_ACCOUNT_SID, WHATSAPP_FROM)
# WHATSAPP_ENABLED=0

# Cartes flotte (CORR-040) : fuseau horaire des plafonds journaliers et mensuels (défaut Africa/Bamako)
# FLEET_TZ=Africa/Bamako

# Domaine public servi par Caddy (Caddyfile). Obligatoire en déploiement avec Caddy ; vérifié par `npm run doctor`.
APP_DOMAIN=
