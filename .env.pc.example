# Modèle de configuration locale — remplacez les valeurs d'exemple avant utilisation.
# Base de TEST locale uniquement pendant la préparation et les essais.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/station_manager_test
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CORS_ORIGIN=http://127.0.0.1:3000

# Stockage séparé du dossier du code
UPLOAD_DIR=D:/StationManagerData/uploads
BACKUP_DIR=D:/StationManagerData/backups
BACKUP_KEEP_DAYS=30
BACKUP_AUTO=0

# Opérations sensibles désactivées par défaut
RESTORE_ENABLED=0
RESTORE_TARGET_ISOLATED=0
RESET_GLOBAL_ENABLED=0
CLIENT_RESTORE_ENABLED=0
CLIENT_RESET_ENABLED=0
PLATFORM_RESTORE_ENABLED=0

# Outils PostgreSQL : renseignez les chemins si absents du PATH
# PG_DUMP=C:/Program Files/PostgreSQL/18/bin/pg_dump.exe
# PSQL=C:/Program Files/PostgreSQL/18/bin/psql.exe

# Notifications facultatives — aucun envoi si SMTP non configuré
MAIL_MODE=json
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
BACKUP_NOTIFY_EMAIL=

