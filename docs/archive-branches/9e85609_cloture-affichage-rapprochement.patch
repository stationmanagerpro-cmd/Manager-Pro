   + '<h3>Caisse</h3>' + T(['Initiale', 'Théorique', 'Comptée', 'Écart'], [[f(r.cash.opening), f(r.cash.theoretical), f(r.cash.counted), `<b style="color:${r.cash.gap ? 'var(--r)' : 'var(--p)'}">${f(r.cash.gap)}</b>`]])
+  + (r.tank_check ? '<h3>Rapprochement par jaugeage</h3>' + (r.tank_check.products && r.tank_check.products.length ? T(['Produit', 'Statut', 'Théorique (L)', 'Mesuré (L)', 'Écart (L)', 'Niveau'], r.tank_check.products.map(p => [esc(p.product_name || ''), p.status === 'calcule' ? 'calculé' : (p.status === 'sans_cuve' ? 'pas de cuve' : 'jauge manquante'), p.theoretical ?? '', p.closing ?? '', p.variance ?? '', esc(p.level || '')])) : '<p class="muted">Aucun produit réconcilié.</p>') + (r.tank_check.dip_verified ? '<p style="color:var(--p)">Écarts individuels vérifiés par jaugeage.</p>' : '<p class="warn"><b>Écarts individuels non vérifiés par jaugeage</b> : les montants par employé ne sont pas garantis.</p>') : '')
+  + (r.counter_continuity && r.counter_continuity.length ? '<h3>Continuité des index</h3>' + T(['Compteur', 'Index fin quart précédent', 'Index de départ', 'Différence (L)'], r.counter_continuity.map(x => [esc(x.label), x.expected, x.index_start, x.diff])) : '')
   + '<h3>Stock</h3>' + T(['Produit', 'Théorique', 'Physique', 'Écart'], r.stock.map(x => [esc(x.product), x.theoretical, x.physical ?? '', x.gap ?? '']))
