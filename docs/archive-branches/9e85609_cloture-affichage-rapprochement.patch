   + T(['Pompe', 'Cpt', 'Produit', 'Initial', 'Final', 'Litres', 'Prix', 'Montant'], r.counters.map(c => [esc(c.pump), c.counter, esc(c.product), c.index_start, c.index_end, c.liters, f(c.unit_price), f(c.amount)]))
